# PostgreSQL Connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/autometric

PGHOST=localhost
PGPORT=5432
PGDATABASE=autometric
PGUSER=postgres
PGPASSWORD=your_password

# Gmail SMTP (generate App Password at myaccount.google.com/apppasswords)
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password

# NextAuth
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Google OAuth (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# MetaGraph Api
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Instagram OAuth (Instagram App - Sekata Connector-IG)
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
NEXT_PUBLIC_APP_URL=your_public_app_url_for_oauth_redirects (e.g., https://yourapp.ngrok-free.dev)

# TikTok OAuth (from TikTok Developer Portal > App > Keys & credentials)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Cloudinary (for avatar storage — create a free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instagram snapshot window (days of historical data to fetch, default 60)
IG_SNAPSHOT_DAYS=60

# Scheduler secret — used to authenticate POST /api/scheduler/run
# Generate with: openssl rand -base64 32
SCHEDULER_SECRET=your_scheduler_secret

# Hiker API (for competitor Instagram scraping — get key at hikerapi.com)
HIKER_API_KEY=your_hiker_api_key