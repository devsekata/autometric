{
  "name": "autometric-v2",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate:up": "dotenv -e .env.local -- node-pg-migrate up --migration-file-language sql",
    "migrate:down": "dotenv -e .env.local -- node-pg-migrate down --migration-file-language sql",
    "migrate:create": "dotenv -e .env.local -- node-pg-migrate create --migration-file-language sql",
    "migrate:kol": "dotenv -e .env.local -- node scripts/apply-kol-migration.js",
    "reset:data": "dotenv -e .env.local -- node scripts/reset-data.js",
    "fk:medallion": "dotenv -e .env.local -- node scripts/add-medallion-fks.js",
    "seed:l0": "dotenv -e .env.local -- node scripts/seed-l0.js",
    "seed:admin": "dotenv -e .env.local -- npx tsx seeds/admin.ts",
    "verify:fpk": "dotenv -e .env.local -- node scripts/verify-fpk-wiring.js",
    "verify:profile-real": "dotenv -e .env.local -- npx tsx scripts/verify-creator-profile-real.ts",
    "verify:nav": "npx tsx scripts/verify-discover-nav.ts",
    "verify:my-creators": "dotenv -e .env.local -- npx tsx scripts/verify-my-creators.ts",
    "verify:export": "npx tsx scripts/verify-discover-export.ts",
    "verify:no-tsdb": "npx tsx scripts/verify-no-tsdb.ts",
    "verify:kol-identity": "dotenv -e .env.local -- npx tsx --tsconfig scripts/test/tsconfig.json scripts/verify-kol-identity.ts",
    "verify:kol-persistence": "dotenv -e .env.local -- npx tsx --tsconfig scripts/test/tsconfig.json scripts/verify-kol-persistence.ts",
    "verify:brand-profile-kol": "dotenv -e .env.local -- npx tsx --tsconfig scripts/verify-brand-profile-kol/tsconfig.json scripts/verify-brand-profile-kol.ts",
    "verify:what-matters": "dotenv -e .env.local -- npx tsx scripts/verify-what-matters.ts",
    "whatmatters:port:verify": "npx tsx scripts/verify-what-matters-port.ts",
    "verify:brand-match-wm": "dotenv -e .env.local -- npx tsx scripts/verify-brand-match-what-matters.ts",
    "brand-match:recalc": "dotenv -e .env.local -- npx tsx scripts/brand-match-recalc.ts",
    "verify:brand-match-freshness": "dotenv -e .env.local -- npx tsx --tsconfig scripts/verify-brand-profile-kol/tsconfig.json scripts/verify-brand-match-freshness.ts",
    "verify:creator-gender": "dotenv -e .env.local -- npx tsx --tsconfig scripts/verify-brand-profile-kol/tsconfig.json scripts/verify-creator-gender-filter.ts",
    "verify:brand-profile-directory": "dotenv -e .env.local -- npx tsx --tsconfig scripts/verify-brand-profile-kol/tsconfig.json scripts/verify-brand-profile-directory.ts",
    "mapping-engine": "cd services/mapping-engine && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/d3-cloud": "^1.2.9",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "d3-cloud": "^1.2.9",
    "dotenv": "^17.4.2",
    "html-to-image": "^1.11.13",
    "next": "^16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "node-cron": "^4.2.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "postcss": "^8.5.14",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0"
  }
}
